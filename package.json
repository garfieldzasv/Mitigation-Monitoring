{
  "name": "mitigation-monitoring",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "FFXIV party damage-taken log for ACT + OverlayPlugin: a live overlay and a post-fight review window",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "vite build && node tests/e2e/smoke.e2e.mjs",
    "make-fixture": "tsx scripts/make-fixture.ts",
    "copy-icons": "tsx scripts/copy-icons.ts",
    "release": "tsx scripts/release.ts",
    "import-data": "tsx scripts/import-game-data.ts",
    "estimate-mitigation": "tsx scripts/estimate-mitigation.ts",
    "death-attribution": "tsx scripts/death-attribution.ts",
    "validate-shields": "tsx scripts/validate-shields.ts"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
